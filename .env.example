# ===== Client (VITE_ = ฝังใน bundle, ห้ามใส่ความลับจริง) =====
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_IMGBB_KEY=your_imgbb_key
VITE_GAS_URL=https://script.google.com/macros/s/xxxx/exec

# ===== Server-only (ตั้งบน Vercel → Project Settings → Environment Variables) =====
# AI chat
GEMINI_API_KEY=your_gemini_api_key
GEMINI_CHAT_MODELS=gemini-flash-latest
GEMINI_UNDERWRITE_MODELS=gemini-flash-latest

# Hermes agent integration (optional)
# When HERMES_AGENT_URL is set, /api/chat and /api/assess-chat use Hermes first.
# Leave it empty to keep using Gemini.
HERMES_AGENT_URL=
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes
# openai = OpenAI-compatible chat payload, generic = AssetX/Hermes generic payload
HERMES_AGENT_FORMAT=openai
HERMES_AGENT_TIMEOUT_MS=60000
# Local dev fallback: call the Hermes CLI directly instead of an HTTP URL.
# Use this when Hermes dashboard/gateway returns 404 for chat requests.
HERMES_AGENT_TRANSPORT=
HERMES_CLI_PATH=hermes

# Research/web search for Hermes or server-side research tools (optional)
# Get this from https://app.tavily.com/ and keep it server-side only.
TAVILY_API_KEY=your_tavily_api_key

# Login (S4) — แทน admin/assetx ที่ hardcode เดิม
APP_USERNAME=your_admin_username
APP_PASSWORD=your_strong_password

# Session cookie signing (S5) — สุ่มยาว ๆ เช่น `openssl rand -hex 32`
SESSION_SECRET=change_me_to_a_long_random_string

# LINE webhook signature verification (S6) — Channel Secret จาก LINE Developers
LINE_CHANNEL_SECRET=your_line_channel_secret

# LINE push message (Channel Access Token) — ใช้โดย api/daily-notify.js
# ค่าเดียวกับที่ตั้งไว้ใน GAS Script Properties key "LINE_TOKEN"
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ป้องกัน /api/daily-notify ไม่ให้ใครก็เรียกได้ — Vercel Cron จะส่ง
# header "Authorization: Bearer <ค่านี้>" มาอัตโนมัติเมื่อตั้งค่านี้ไว้
# สุ่มด้วย: openssl rand -hex 32
CRON_SECRET=change_me_to_a_long_random_string
