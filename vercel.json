{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/marketing-image", "destination": "/api/marketing-image" },
    { "source": "/api/marketing-video", "destination": "/api/marketing-video" },
    { "source": "/api/marketing-references", "destination": "/api/marketing-references" },
    { "source": "/api/marketing-knowledge-save", "destination": "/api/marketing-knowledge-save" },
    { "source": "/api/telegram-webhook", "destination": "/api/telegram-webhook" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/daily-notify", "schedule": "0 1 * * *" }
  ]
}
