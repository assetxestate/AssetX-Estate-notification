{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/marketing-image.js": {
      "maxDuration": 30
    },
    "api/marketing-video.js": {
      "maxDuration": 60
    },
    "api/marketing-references.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/telegram-webhook", "destination": "/api/telegram-webhook" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/daily-notify", "schedule": "0 1 * * *" }
  ]
}
