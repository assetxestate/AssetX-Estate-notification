{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/notices", "destination": "/api/marketing?feature=notices" },
    { "source": "/api/diary", "destination": "/api/marketing?feature=diary" },
    { "source": "/api/payment-additions", "destination": "/api/marketing?feature=payment-additions" },
    { "source": "/api/chat", "destination": "/api/chat" },
    { "source": "/api/line-webhook", "destination": "/api/line-webhook" },
    { "source": "/api/marketing-image", "destination": "/api/marketing?feature=image" },
    { "source": "/api/marketing-image-jobs", "destination": "/api/marketing?feature=image-jobs" },
    { "source": "/api/marketing-content-jobs", "destination": "/api/marketing?feature=content-jobs" },
    { "source": "/api/marketing-video", "destination": "/api/marketing?feature=video" },
    { "source": "/api/marketing-references", "destination": "/api/marketing?feature=references" },
    { "source": "/api/marketing-radar", "destination": "/api/marketing?feature=radar" },
    { "source": "/api/marketing-knowledge-save", "destination": "/api/marketing?feature=knowledge-save" },
    { "source": "/api/marketing-facebook", "destination": "/api/marketing?feature=facebook" },
    { "source": "/api/marketing-ideas", "destination": "/api/marketing?feature=ideas" },
    { "source": "/api/telegram-webhook", "destination": "/api/telegram-webhook" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/daily-notify", "schedule": "0 1 * * *" }
  ]
}
